rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isNewDocOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Extra Hours Collection
    match /extraHours/{extraHourId} {
      allow get: if isSignedIn() && isDocOwner();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isNewDocOwner() && isValidId(extraHourId);
      allow update: if isSignedIn() && isDocOwner() && isNewDocOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // Settings Collection
    match /settings/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isDocOwner();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isNewDocOwner() && isValidId(notificationId);
      allow update: if isSignedIn() && isDocOwner() && isNewDocOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }
  }
}
